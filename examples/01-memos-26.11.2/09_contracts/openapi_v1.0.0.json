{
  "openapi": "3.1.0",
  "info": {
    "title": "usememos/memos Core HTTP API Contract (Pinned 26.11.2)",
    "version": "26.11.2",
    "license": {
      "name": "MIT",
      "url": "https://github.com/usememos/memos/blob/00fcd170281a75fc0e95ec4f2f54f43d32fe81bd/LICENSE"
    },
    "description": "Machine-readable HTTP/JSON gateway contract derived from proto/api/*.proto and verified against official darwin_arm64 release 26.11.2."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}",
      "description": "Isolated loopback verification server",
      "variables": { "port": { "default": "8081" } }
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" },
      "refreshCookie": { "type": "apiKey", "in": "cookie", "name": "memos_refresh_token" }
    },
    "schemas": {
      "InstanceProfile": {
        "type": "object",
        "required": ["version", "demo", "needsSetup", "accessMode"],
        "properties": {
          "admin": { "type": "string", "description": "Returned to signed-in callers only; omitted for anonymous callers" },
          "version": { "type": "string", "example": "26.11.2" },
          "commit": { "type": "string" },
          "demo": { "type": "boolean" },
          "needsSetup": { "type": "boolean", "description": "True when zero users exist in SQLite user table" },
          "accessMode": { "type": "string", "enum": ["INSTANCE_ACCESS_MODE_PRIVATE", "INSTANCE_ACCESS_MODE_PUBLIC"], "description": "Defaults to INSTANCE_ACCESS_MODE_PRIVATE on fresh 26.11.2 installs" },
          "instanceUrl": { "type": "string" }
        }
      },
      "User": {
        "type": "object",
        "required": ["name", "username", "role", "state"],
        "properties": {
          "name": { "type": "string", "pattern": "^users/.+$" },
          "username": { "type": "string" },
          "displayName": { "type": "string" },
          "email": { "type": "string" },
          "role": { "type": "string", "enum": ["ADMIN", "USER"] },
          "state": { "type": "string", "enum": ["NORMAL", "ARCHIVED"] }
        }
      },
      "CreateUserBody": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string" },
          "password": { "type": "string", "writeOnly": true },
          "displayName": { "type": "string" },
          "email": { "type": "string" },
          "role": { "type": "string", "enum": ["ADMIN", "USER"] }
        }
      },
      "SignInRequest": {
        "type": "object",
        "properties": {
          "passwordCredentials": {
            "type": "object",
            "required": ["username", "password"],
            "properties": {
              "username": { "type": "string" },
              "password": { "type": "string", "writeOnly": true }
            }
          }
        }
      },
      "SignInResponse": {
        "type": "object",
        "required": ["user", "accessToken"],
        "properties": {
          "user": { "$ref": "#/components/schemas/User" },
          "accessToken": { "type": "string" },
          "accessTokenExpireTime": { "type": "string", "format": "date-time" }
        }
      },
      "Memo": {
        "type": "object",
        "required": ["name", "content", "visibility", "state"],
        "properties": {
          "name": { "type": "string", "pattern": "^memos/.+$" },
          "creator": { "type": "string", "pattern": "^users/.+$" },
          "content": { "type": "string" },
          "visibility": { "type": "string", "enum": ["PRIVATE", "PROTECTED", "PUBLIC", "SPACE"] },
          "state": { "type": "string", "enum": ["NORMAL", "ARCHIVED"] },
          "pinned": { "type": "boolean" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      },
      "MemoShare": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "pattern": "^memos/.+/shares/.+$" },
          "createTime": { "type": "string", "format": "date-time" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "integer" },
          "message": { "type": "string" },
          "details": { "type": "array", "items": { "type": "object" } }
        }
      }
    }
  },
  "paths": {
    "/api/instance/profile": {
      "get": {
        "operationId": "GetInstanceProfile",
        "x-feature-id": "F-002",
        "summary": "Public instance metadata and host initialization state",
        "responses": {
          "200": {
            "description": "OK (Cache-Control: no-store)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InstanceProfile" } } }
          }
        }
      }
    },
    "/api/users": {
      "post": {
        "operationId": "CreateUser",
        "x-feature-id": "F-004",
        "summary": "Create user; first user on empty DB becomes ADMIN host",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateUserBody" } } }
        },
        "responses": {
          "200": { "description": "Created user without password field", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } } },
          "400": { "description": "Invalid argument", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/auth/signin": {
      "post": {
        "operationId": "SignIn",
        "x-feature-id": "F-005",
        "summary": "Authenticate with password credentials; issues accessToken and HttpOnly refresh cookie",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SignInRequest" } } }
        },
        "responses": {
          "200": { "description": "Authenticated (note: HttpOnly Set-Cookie refresh rotation is emitted on Connect-RPC /memos.api.AuthService/SignIn via HeaderCarrier)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SignInResponse" } } } },
          "400": { "description": "Invalid username or password (codes.InvalidArgument)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "GetCurrentUser",
        "x-feature-id": "F-005",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Authenticated user" },
          "401": { "description": "Unauthenticated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "operationId": "RefreshToken",
        "x-feature-id": "F-005",
        "security": [{ "refreshCookie": [] }],
        "responses": {
          "200": { "description": "Rotated access token" },
          "401": { "description": "Missing or revoked refresh cookie" }
        }
      }
    },
    "/api/auth/signout": {
      "post": {
        "operationId": "SignOut",
        "x-feature-id": "F-005",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Signed out and refresh cookie revoked" }
        }
      }
    },
    "/api/memos": {
      "get": {
        "operationId": "ListMemos",
        "x-feature-id": "F-008",
        "parameters": [
          { "name": "state", "in": "query", "schema": { "type": "string", "enum": ["NORMAL", "ARCHIVED"] } },
          { "name": "filter", "in": "query", "schema": { "type": "string" }, "description": "CEL filter expression (e.g., tag in [\"release\"], content.contains(\"50%_off\"))" }
        ],
        "responses": {
          "200": { "description": "Filtered list respecting caller visibility" },
          "400": { "description": "Invalid CEL filter expression", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "post": {
        "operationId": "CreateMemo",
        "x-feature-id": "F-006",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Memo" } } }
        },
        "responses": {
          "200": { "description": "Created memo (pinned always false on creation)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Memo" } } } },
          "401": { "description": "Unauthenticated" }
        }
      }
    },
    "/api/memos/{uid}": {
      "get": {
        "operationId": "GetMemo",
        "x-feature-id": "F-009",
        "parameters": [{ "name": "uid", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Memo resource" },
          "401": { "description": "Private memo requires authentication" },
          "403": { "description": "Permission denied" },
          "404": { "description": "Memo not found" }
        }
      },
      "patch": {
        "operationId": "UpdateMemo",
        "x-feature-id": "F-007",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "uid", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "updateMask", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Updated memo" }
        }
      },
      "delete": {
        "operationId": "DeleteMemo",
        "x-feature-id": "F-007",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "uid", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Deleted" }
        }
      }
    },
    "/api/memos/{uid}/shares": {
      "post": {
        "operationId": "CreateMemoShare",
        "x-feature-id": "F-009",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "uid", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Created share token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MemoShare" } } } }
        }
      }
    },
    "/api/shares/{share_token}/memo": {
      "get": {
        "operationId": "GetSharedMemo",
        "x-feature-id": "F-009",
        "parameters": [{ "name": "share_token", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Shared memo readable without authentication" },
          "404": { "description": "Invalid or expired share token" }
        }
      }
    }
  }
}

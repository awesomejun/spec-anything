{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-anything.local/schemas/evidence_v1.0.0.schema.json",
  "title": "spec-anything 06 Machine-Readable Evidence Record",
  "type": "object",
  "required": [
    "evidence_id",
    "feature_id",
    "source_ref",
    "pinned_commit",
    "artifact_sha256",
    "tool_and_env",
    "input_and_precondition",
    "observed_output",
    "status",
    "limitations",
    "linked_artifacts"
  ],
  "properties": {
    "evidence_id": { "type": "string", "pattern": "^EV-[0-9]{3}$" },
    "feature_id": { "type": "string", "pattern": "^F-[0-9]{3}$" },
    "source_ref": { "type": "string", "minLength": 3 },
    "pinned_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "tool_and_env": { "type": "string", "minLength": 5 },
    "input_and_precondition": { "type": "object" },
    "observed_output": { "type": "object" },
    "status": {
      "type": "string",
      "enum": ["observed", "code-verified", "inferred", "assumed", "unverified"]
    },
    "limitations": { "type": "string" },
    "linked_artifacts": { "type": "object" }
  },
  "additionalProperties": false
}

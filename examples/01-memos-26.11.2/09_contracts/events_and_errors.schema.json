{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-anything.local/schemas/events_and_errors_v1.0.0.schema.json",
  "title": "Memos 26.11.2 Error Envelope & Lifecycle Transition Contract",
  "type": "object",
  "defs_version": "1.0.0",
  "$defs": {
    "GrpcGatewayError": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "integer", "description": "gRPC canonical status code (e.g., 3=INVALID_ARGUMENT, 5=NOT_FOUND, 16=UNAUTHENTICATED)" },
        "message": { "type": "string" },
        "details": { "type": "array", "items": { "type": "object" } }
      }
    },
    "MemoVisibility": {
      "type": "string",
      "enum": ["PRIVATE", "PROTECTED", "PUBLIC", "SPACE"]
    },
    "MemoState": {
      "type": "string",
      "enum": ["NORMAL", "ARCHIVED"]
    },
    "UserRole": {
      "type": "string",
      "enum": ["ADMIN", "USER"]
    },
    "AuthSessionEvent": {
      "type": "object",
      "required": ["event_type", "http_status", "refresh_cookie_action"],
      "properties": {
        "event_type": { "type": "string", "enum": ["SIGN_IN", "REFRESH_ROTATE", "SIGN_OUT", "UNAUTHENTICATED_REJECT"] },
        "http_status": { "type": "integer" },
        "refresh_cookie_action": { "type": "string", "enum": ["set_httponly", "rotate_httponly", "clear_cookie", "none"] },
        "access_token_in_body": { "type": "boolean" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-anything.local/contracts/pomotroid-v1.7.1/ipc.schema.json",
  "title": "Pomotroid v1.7.1 Timer, Settings, Theme, Stats & WebSocket Contract",
  "type": "object",
  "properties": {
    "timer_snapshot": { "$ref": "#/$defs/TimerSnapshot" },
    "settings": { "$ref": "#/$defs/Settings" },
    "theme": { "$ref": "#/$defs/Theme" },
    "ws_server_event": { "$ref": "#/$defs/WsEvent" }
  },
  "$defs": {
    "RoundType": {
      "type": "string",
      "enum": ["work", "short-break", "long-break"]
    },
    "TimerSnapshot": {
      "type": "object",
      "required": [
        "round_type",
        "previous_round_type",
        "elapsed_secs",
        "total_secs",
        "is_running",
        "is_paused",
        "work_round_number",
        "work_rounds_total",
        "session_work_count"
      ],
      "properties": {
        "round_type": { "$ref": "#/$defs/RoundType" },
        "previous_round_type": { "type": "string", "enum": ["", "work", "short-break", "long-break"] },
        "elapsed_secs": { "type": "integer", "minimum": 0 },
        "total_secs": { "type": "integer", "minimum": 1 },
        "is_running": { "type": "boolean" },
        "is_paused": { "type": "boolean" },
        "work_round_number": { "type": "integer", "minimum": 0 },
        "work_rounds_total": { "type": "integer", "minimum": 1 },
        "session_work_count": { "type": "integer", "minimum": 1 }
      }
    },
    "Settings": {
      "type": "object",
      "required": [
        "time_work_secs",
        "time_short_break_secs",
        "time_long_break_secs",
        "long_break_interval",
        "short_breaks_enabled",
        "long_breaks_enabled",
        "dial_countdown",
        "theme_mode",
        "theme_light",
        "theme_dark",
        "volume"
      ],
      "properties": {
        "time_work_secs": { "type": "integer", "minimum": 60, "maximum": 5400 },
        "time_short_break_secs": { "type": "integer", "minimum": 60, "maximum": 5400 },
        "time_long_break_secs": { "type": "integer", "minimum": 60, "maximum": 5400 },
        "long_break_interval": { "type": "integer", "minimum": 1, "maximum": 12 },
        "short_breaks_enabled": { "type": "boolean" },
        "long_breaks_enabled": { "type": "boolean" },
        "auto_start_work": { "type": "boolean" },
        "auto_start_break": { "type": "boolean" },
        "dial_countdown": { "type": "boolean" },
        "theme_mode": { "type": "string", "enum": ["auto", "light", "dark"] },
        "theme_light": { "type": "string" },
        "theme_dark": { "type": "string" },
        "volume": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "websocket_enabled": { "type": "boolean" },
        "websocket_port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "language": { "type": "string" }
      }
    },
    "Theme": {
      "type": "object",
      "required": ["name", "colors", "is_custom"],
      "properties": {
        "name": { "type": "string" },
        "is_custom": { "type": "boolean" },
        "colors": {
          "type": "object",
          "required": [
            "--color-long-round",
            "--color-short-round",
            "--color-focus-round",
            "--color-background",
            "--color-background-light",
            "--color-foreground",
            "--color-accent"
          ],
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "WsEvent": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["state", "started", "roundChange", "paused", "resumed", "reset", "error"] },
        "payload": { "type": "object" },
        "message": { "type": "string" }
      }
    }
  }
}

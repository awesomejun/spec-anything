{
  "schema_version": "1.0.0",
  "source_css_ref": "ui/src/css/vars.css",
  "computed_live_dom": {
    "viewport": {
      "width": 1440,
      "height": 900
    },
    "css_vars_computed": {
      "--primaryColor": "#25272d",
      "--secondaryColor": "#e4e8ec",
      "--accentColor": "#1055c9",
      "--successColor": "#22a96d",
      "--dangerColor": "#c33751",
      "--surfaceColor": "#fff",
      "--surfaceAlt1Color": "#f8f9fa",
      "--surfaceTxtColor": "#25272d",
      "--baseFontFamily": "\"IBM Plex Sans\", system-ui, sans-serif, emoji",
      "--monospaceFontFamily": "\"IBM Plex Mono\", ui-monospace, monospace, emoji",
      "--fontSize": "14px",
      "--lineHeight": "22px",
      "--btnHeight": "45px",
      "--borderRadius": "5px",
      "--spacing": "30px"
    },
    "elements": {
      "body": {
        "selector": "body",
        "width": 1440,
        "height": 900,
        "fontFamily": "\"IBM Plex Sans\", system-ui, sans-serif, emoji",
        "fontSize": "14px",
        "fontWeight": "400",
        "color": "rgb(37, 39, 45)",
        "backgroundColor": "rgb(255, 255, 255)",
        "borderRadius": "0px",
        "padding": "0px"
      },
      "sidebar": {
        "selector": "aside, .app-sidebar, nav",
        "width": 269,
        "height": 30,
        "fontFamily": "\"IBM Plex Sans\", system-ui, sans-serif, emoji",
        "fontSize": "13px",
        "fontWeight": "400",
        "color": "rgb(255, 255, 255)",
        "backgroundColor": "rgba(0, 0, 0, 0)",
        "borderRadius": "0px",
        "padding": "3px"
      },
      "primary_button": {
        "selector": "button.btn, .btn, button",
        "width": 26,
        "height": 24,
        "fontFamily": "\"IBM Plex Sans\", system-ui, sans-serif, emoji",
        "fontSize": "13px",
        "fontWeight": "700",
        "color": "color(srgb 1 1 1 / 0.6)",
        "backgroundColor": "rgba(0, 0, 0, 0)",
        "borderRadius": "5px",
        "padding": "4px 5px"
      },
      "search_input": {
        "selector": "input[type='search'], input[type='text'], input",
        "width": 199,
        "height": 49,
        "fontFamily": "\"IBM Plex Sans\", system-ui, sans-serif, emoji",
        "fontSize": "14px",
        "fontWeight": "400",
        "color": "rgb(37, 39, 45)",
        "backgroundColor": "rgba(0, 0, 0, 0)",
        "borderRadius": "0px",
        "padding": "10px 5px 10px 15px"
      },
      "table_row": {
        "selector": "table tbody tr, tr",
        "width": 1200,
        "height": 45,
        "fontFamily": "\"IBM Plex Sans\", system-ui, sans-serif, emoji",
        "fontSize": "14px",
        "fontWeight": "400",
        "color": "rgb(37, 39, 45)",
        "backgroundColor": "rgba(0, 0, 0, 0)",
        "borderRadius": "0px",
        "padding": "0px"
      }
    }
  }
}

{
  "openapi": "3.1.0",
  "info": {
    "title": "PocketBase v0.40.6 Observed Parity Surface API",
    "version": "0.40.6",
    "license": { "name": "MIT", "url": "https://github.com/pocketbase/pocketbase/blob/v0.40.6/LICENSE.md" }
  },
  "servers": [{ "url": "http://127.0.0.1:8090" }],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Liveness and backup readiness check (F-003)",
        "responses": {
          "200": {
            "description": "Healthy server response",
            "content": {
              "application/json": {
                "example": { "code": 200, "message": "API is healthy.", "data": { "canBackup": true } }
              }
            }
          }
        }
      }
    },
    "/api/collections/_superusers/auth-with-password": {
      "post": {
        "operationId": "authSuperuserWithPassword",
        "summary": "Authenticate superuser with email/identity and password (F-004)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["identity", "password"],
                "properties": {
                  "identity": { "type": "string", "format": "email" },
                  "password": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Authenticated JWT token and superuser record" },
          "400": { "description": "Invalid credentials (Failed to authenticate.)" }
        }
      }
    },
    "/api/collections": {
      "get": {
        "operationId": "listCollections",
        "summary": "List collections (superuser only) (F-005)",
        "responses": {
          "200": { "description": "Paginated collection list" },
          "401": { "description": "Missing or invalid authorization token" },
          "403": { "description": "Forbidden for non-superuser" }
        }
      },
      "post": {
        "operationId": "createCollection",
        "summary": "Create a dynamic collection and materialize its SQLite table (F-006)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "./collection.schema.json" }
            }
          }
        },
        "responses": {
          "200": { "description": "Created collection metadata" },
          "400": { "description": "Schema validation error" }
        }
      }
    },
    "/api/collections/{collection}/records": {
      "get": {
        "operationId": "listRecords",
        "summary": "Query collection records with fexpr filter, sort, and pagination (F-008)",
        "parameters": [
          { "name": "collection", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "filter", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "sort", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "default": 1 } },
          { "name": "perPage", "in": "query", "required": false, "schema": { "type": "integer", "default": 30 } }
        ],
        "responses": {
          "200": { "description": "Paginated items response" },
          "400": { "description": "Invalid filter expression or sort field" }
        }
      },
      "post": {
        "operationId": "createRecord",
        "summary": "Create a record with collection field & index validation (F-007)",
        "parameters": [
          { "name": "collection", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Persisted record with 15-character ID" },
          "400": { "description": "Field or unique index constraint validation error" }
        }
      }
    },
    "/api/realtime": {
      "get": {
        "operationId": "connectRealtimeSSE",
        "summary": "Establish SSE stream emitting initial PB_CONNECT clientId (F-009)",
        "responses": {
          "200": { "description": "text/event-stream SSE connection" }
        }
      },
      "post": {
        "operationId": "setRealtimeSubscriptions",
        "summary": "Bind topic subscriptions to an active SSE clientId (F-009)",
        "responses": {
          "204": { "description": "Subscriptions updated" },
          "404": { "description": "Unknown or expired clientId" }
        }
      }
    },
    "/api/settings": {
      "get": {
        "operationId": "getSettings",
        "summary": "Read application settings (superuser only) (F-010)",
        "responses": { "200": { "description": "Application settings object" } }
      },
      "patch": {
        "operationId": "updateSettings",
        "summary": "Partially update persisted application settings (F-010)",
        "responses": { "200": { "description": "Updated settings object" } }
      }
    },
    "/api/backups": {
      "get": {
        "operationId": "listBackups",
        "summary": "List available backup zip archives (superuser only) (F-011)",
        "responses": { "200": { "description": "Array of backup entries (key, size, modified)" } }
      },
      "post": {
        "operationId": "createBackup",
        "summary": "Create an on-demand zip snapshot of pb_data (F-011)",
        "responses": { "204": { "description": "Backup archive created" } }
      }
    },
    "/api/crons": {
      "get": {
        "operationId": "listCrons",
        "summary": "List registered scheduled jobs (superuser only) (F-015)",
        "responses": { "200": { "description": "Array of cron descriptors" } }
      }
    }
  }
}

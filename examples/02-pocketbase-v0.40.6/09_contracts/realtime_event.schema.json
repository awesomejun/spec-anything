{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PocketBase Realtime SSE Event Frame",
  "type": "object",
  "required": ["event", "data"],
  "properties": {
    "id": { "type": "string" },
    "event": { "type": "string" },
    "data": {
      "oneOf": [
        {
          "type": "object",
          "required": ["clientId"],
          "properties": { "clientId": { "type": "string", "minLength": 1 } }
        },
        {
          "type": "object",
          "required": ["action", "record"],
          "properties": {
            "action": { "type": "string", "enum": ["create", "update", "delete"] },
            "record": { "type": "object" }
          }
        }
      ]
    }
  }
}

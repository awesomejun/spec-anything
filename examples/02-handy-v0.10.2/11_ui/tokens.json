{
  "schema_version": "1.0.0",
  "source_css_ref": "src/styles/theme.css",
  "app_css_ref": "src/App.css",
  "theme": "light",
  "computed_live_dom": {
    "viewport": {
      "width": 1024,
      "height": 700
    },
    "root_font_size": "15px",
    "root_line_height": "24px",
    "css_vars_computed": {
      "--color-text": "#0f0f0f",
      "--color-background": "#fbfbfb",
      "--color-background-ui": "#da5893",
      "--color-logo-primary": "#faa2ca",
      "--color-warning": "#d97706",
      "--color-error": "#dc2626",
      "--color-moss": "#2f7d5b",
      "--color-plum": "#382731",
      "--color-ink-2": "color-mix(in srgb, #0f0f0f 60%, transparent)",
      "--color-ink-3": "#808080",
      "--color-line": "color-mix(in srgb, #808080 20%, transparent)",
      "--color-line-strong": "color-mix(\n    in srgb,\n    #808080 80%,\n    transparent\n  )",
      "--color-wash": "color-mix(in srgb, #808080 10%, transparent)",
      "--color-wordmark": "#faa2ca",
      "--color-wordmark-stroke": "#382731",
      "--font-display": "ui-rounded, \"SF Pro Rounded\", system-ui, -apple-system,\n    \"Segoe UI Variable Display\", \"Segoe UI\", sans-serif",
      "--font-ui": "system-ui, -apple-system, \"Segoe UI Variable Text\", \"Segoe UI\", Roboto,\n    \"Noto Sans\", sans-serif",
      "--text-title": "26px",
      "--text-body": "15px",
      "--text-small": "13px",
      "--text-label": "12px",
      "--radius-panel": "16px",
      "--radius-card": "12px",
      "--radius-control": "10px",
      "--radius-chip": "6px"
    },
    "elements": {
      "body": {
        "selector": "body",
        "width": 1024,
        "height": 700,
        "fontFamily": "ui-sans-serif, system-ui, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\", \"Noto Color Emoji\"",
        "fontSize": "15px",
        "fontWeight": "400",
        "lineHeight": "24px",
        "color": "rgb(15, 15, 15)",
        "backgroundColor": "rgba(0, 0, 0, 0)",
        "borderColor": "rgb(15, 15, 15)",
        "borderRadius": "0px",
        "padding": "0px"
      },
      "sidebar": {
        "selector": ".w-40 (Sidebar)",
        "width": 150,
        "height": 662,
        "fontFamily": "ui-sans-serif, system-ui, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\", \"Noto Color Emoji\"",
        "fontSize": "15px",
        "fontWeight": "400",
        "lineHeight": "24px",
        "color": "rgb(15, 15, 15)",
        "backgroundColor": "rgba(0, 0, 0, 0)",
        "borderColor": "color(srgb 0.501961 0.501961 0.501961 / 0.2)",
        "borderRadius": "0px",
        "padding": "0px 7.5px"
      },
      "sidebar_active_item": {
        "selector": "Sidebar active item",
        "width": 134,
        "height": 39,
        "fontFamily": "ui-sans-serif, system-ui, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\", \"Noto Color Emoji\"",
        "fontSize": "15px",
        "fontWeight": "400",
        "lineHeight": "24px",
        "color": "rgb(15, 15, 15)",
        "backgroundColor": "oklab(0.810802 0.113297 -0.0175908 / 0.8)",
        "borderColor": "rgb(15, 15, 15)",
        "borderRadius": "7.5px",
        "padding": "7.5px"
      },
      "settings_group_card": {
        "selector": "SettingsGroup card",
        "width": 720,
        "height": 139,
        "fontFamily": "ui-sans-serif, system-ui, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\", \"Noto Color Emoji\"",
        "fontSize": "15px",
        "fontWeight": "400",
        "lineHeight": "24px",
        "color": "rgb(15, 15, 15)",
        "backgroundColor": "rgb(251, 251, 251)",
        "borderColor": "color(srgb 0.501961 0.501961 0.501961 / 0.2)",
        "borderRadius": "7.5px",
        "padding": "0px"
      },
      "settings_heading": {
        "selector": "h2",
        "width": 690,
        "height": 15,
        "fontFamily": "ui-sans-serif, system-ui, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\", \"Noto Color Emoji\"",
        "fontSize": "11.25px",
        "fontWeight": "500",
        "lineHeight": "15px",
        "color": "rgb(128, 128, 128)",
        "backgroundColor": "rgba(0, 0, 0, 0)",
        "borderColor": "rgb(128, 128, 128)",
        "borderRadius": "0px",
        "padding": "0px"
      },
      "footer": {
        "selector": "Footer bar",
        "width": 1024,
        "height": 39,
        "fontFamily": "ui-sans-serif, system-ui, sans-serif, \"Apple Color Emoji\", \"Segoe UI Emoji\", \"Segoe UI Symbol\", \"Noto Color Emoji\"",
        "fontSize": "15px",
        "fontWeight": "400",
        "lineHeight": "24px",
        "color": "rgb(15, 15, 15)",
        "backgroundColor": "rgba(0, 0, 0, 0)",
        "borderColor": "color(srgb 0.501961 0.501961 0.501961 / 0.2)",
        "borderRadius": "0px",
        "padding": "11.25px 0px 0px"
      }
    }
  }
}
